# Copy this file to ".env" in the project root and edit values as needed.
# Django Core Settings
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: use sqlite for simple Windows installs (recommended for the client PC)
DB_ENGINE=sqlite

# If you later switch to MySQL, set DB_ENGINE=mysql and fill these:
DB_NAME=habibi_db
DB_USER=habibi_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=60

# Email (optional on local install — leave as-is if email is not needed yet)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@localhost
EMAIL_TIMEOUT=30

# Static and Media Settings
STATIC_URL=static/
STATIC_ROOT=static/
MEDIA_URL=media/
MEDIA_ROOT=media/

# CORS / frontend (Vite default port)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API / auth
API_PAGE_SIZE=12
TOKEN_EXPIRY_DAYS=7
TOKEN_LIMIT=0

# Frontend URL (used in emails)
FRONTEND_URL=http://localhost:5173
